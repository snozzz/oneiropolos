{
  "name": "wbloop",
  "version": "0.5.0",
  "description": "Oneiropolos (守梦人 · 夢守): a lead plans and audits, an executor does the work — GPT, Claude, DeepSeek or WorkBuddy in either role — a local agent orchestrator with snow-cli style sub-agents, Team Mode, hooks, skills and MCP",
  "type": "module",
  "bin": {
    "wbloop": "bin/wbloop.js",
    "onei": "bin/onei.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "app": "node bin/wbloop.js app",
    "serve": "node bin/wbloop.js serve --open",
    "doctor": "node bin/wbloop.js doctor",
    "build:app": "bash app/build-app.sh",
    "test": "node --test test/*.test.js",
    "app:windows": "electron .",
    "build:windows": "electron-builder --config app/windows/builder.cjs --win --publish never && node app/windows/checksums.cjs",
    "build:windows:dir": "electron-builder --config app/windows/builder.cjs --win --dir --publish never"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "main": "app/windows/main.cjs",
  "author": "snozzz"
}
